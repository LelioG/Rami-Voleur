{
  "name": "rami-voleur-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-card-assets.mjs",
    "verify-assets": "node scripts/verify-card-assets.mjs",
    "dev": "npm run verify-assets && concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "tsup server/src/index.ts --format esm --target node20 --out-dir dist/server --clean",
    "build:client": "vite build --config client/vite.config.ts",
    "build": "npm run verify-assets && npm run typecheck && npm run build:server && npm run build:client",
    "test": "vitest run",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "playwright": "^1.60.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
